* text=auto eol=lf
# These source bytes are bound by the recorded Lean verification hashes.
*.lean -text
*.md text eol=lf
*.json text eol=lf
*.py text eol=lf
*.ps1 text eol=lf
*.svg text eol=lf
*.mmd text eol=lf
*.png binary
# Preserve the exact bytes named by protocol fixture ArtifactRefs on all hosts.
schemas/architecture/*.schema.json -text whitespace=trailing-space,space-before-tab,cr-at-eol
examples/architecture/**/*.json -text
examples/architecture/*.json -text
